# ==============================================
# SaaS Multi-Boutiques - Environment Variables
# ==============================================
# INSTRUCTIONS:
# 1. Copier ce fichier vers .env
# 2. Remplir TOUTES les valeurs
# 3. Ne JAMAIS commiter le fichier .env
# ==============================================

# ----------------------------------------------
# APPLICATION
# ----------------------------------------------
APP_NAME=SaaS-Personnalisation
APP_ENV=development
# Valeurs possibles: development, staging, production
DEBUG=true

# ----------------------------------------------
# DATABASE - MySQL
# ----------------------------------------------
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# URL complète construite automatiquement par l'app:
# mysql+aiomysql://{user}:{password}@{host}:{port}/{database}

# ----------------------------------------------
# SECURITY - JWT
# ----------------------------------------------
# Générer avec: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Durée de vie du token en minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------
# SUPERADMIN - Premier compte plateforme
# ----------------------------------------------
# Créé automatiquement au premier démarrage si inexistant
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ----------------------------------------------
# OAUTH - Google (optionnel pour MVP)
# ----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ----------------------------------------------
# EMAIL - Brevo (ex-Sendinblue)
# ----------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ----------------------------------------------
# CORS - Origines autorisées
# ----------------------------------------------
# Séparer par des virgules si plusieurs
# Ex: https://personnalisation.mon-agenceweb.fr,https://autre-domaine.com
CORS_ORIGINS=

# ----------------------------------------------
# SERVER
# ----------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
