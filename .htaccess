# PERSONNALY - Configuration Apache racine
# Redirige tout vers le dossier public

RewriteEngine On

# Sitemap.xml et robots.txt
RewriteRule ^sitemap\.xml$ /public/sitemap.php [L]
RewriteRule ^robots\.txt$ /public/robots.txt [L]

# Si le fichier ou dossier existe dans public, y accéder directement
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
RewriteRule ^(.*)$ /public/$1 [L]

# Pages légales spécifiques
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^mentions-legales$ /public/mentions-legales.php [L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^cgv$ /public/cgv.php [L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^politique-confidentialite$ /public/politique-confidentialite.php [L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^politique-retour$ /public/politique-retour.php [L]

# Pages personnalisées (slug dynamique) - insensible à la casse
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_URI} !^/admin/
RewriteCond %{REQUEST_URI} !^/produits
RewriteCond %{REQUEST_URI} !^/packs
RewriteCond %{REQUEST_URI} !^/blog
RewriteCond %{REQUEST_URI} !^/contact
RewriteCond %{REQUEST_URI} !^/categorie/
RewriteCond %{REQUEST_URI} !^/panier
RewriteCond %{REQUEST_URI} !^/checkout
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-]+)/?$ /public/page.php?slug=$1 [L,QSA,NC]

# Sinon, tout envoyer vers public/index.php (accueil)
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_URI} !^/admin/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^$ /public/index.php [L]
